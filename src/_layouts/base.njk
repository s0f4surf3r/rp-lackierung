  <meta property="og:image" content="https://rp-lackierung.pages.dev/images/og-image.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:url" content="https://rp-lackierung.pages.dev{{ page.url }}">
  <meta name="theme-color" content="#12141a">
  <link rel="canonical" href="https://rp-lackierung.pages.dev{{ page.url }}">
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" href="/images/favicon-32x32.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="stylesheet" href="/css/style.css">
  <script>(function(){var t=localStorage.getItem('rp-theme')||'dark';var d=t==='light'||(t==='auto'&&!window.matchMedia('(prefers-color-scheme:dark)').matches);if(!d){}else{document.documentElement.classList.add('light')}})()</script>
</head>
<body class="{{ bodyClass or '' }}">

  <a href="#main-content" class="sr-only" style="position:absolute;top:-999px;left:-999px;z-index:9999;padding:1rem;background:var(--color-accent);color:var(--color-bg);">Zum Inhalt springen</a>

  <header class="site-header">
    <div class="header-top">
      <div class="container header-top-inner">
        <a href="mailto:info@rp-lackierung.de" class="header-email">info@rp-lackierung.de</a>
        <a href="tel:07930990111" class="header-phone">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.36 11.36 0 003.55.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.36 11.36 0 00.57 3.55 1 1 0 01-.25 1.02l-2.2 2.22z"/></svg>
          07930 / 990111
        </a>
      </div>
    </div>

    <div class="header-main">
      <div class="container header-main-inner">
        <a href="/" class="logo">
          <img src="/images/logo.png" alt="R+P Lackierung GmbH" width="1536" height="512">
        </a>

        <button class="burger" aria-label="Menü" aria-expanded="false" aria-controls="main-nav">
          <span></span><span></span><span></span>
        </button>

        <nav class="main-nav" id="main-nav">
          <a href="/" {% if page.url == '/' %}aria-current="page"{% endif %}>Willkommen</a>
          <a href="/wir-ueber-uns/" {% if page.url == '/wir-ueber-uns/' %}aria-current="page"{% endif %}>Wir über uns</a>
          <div class="nav-dropdown {% if page.url and '/werkstatt/' in page.url %}is-active{% endif %}">
            <button class="nav-dropdown-toggle">Werkstatt Leistungen</button>
            <div class="nav-dropdown-menu">
              <a href="/werkstatt/fahrzeugaufbereitung/">Fahrzeugaufbereitung</a>
              <a href="/werkstatt/fahrzeugdiagnose/">Fahrzeugdiagnose</a>
              <a href="/werkstatt/inspektion/">Inspektion</a>
              <a href="/werkstatt/karosseriearbeiten/">Karosseriearbeiten</a>
              <a href="/werkstatt/motorradreparatur/">Motorradreparatur</a>
              <a href="/werkstatt/reifenservice/">Reifenservice</a>
              <a href="/werkstatt/smart-spot-repair/">Smart- &amp; Spot-Repair</a>
              <a href="/werkstatt/unfallservice/">Unfallservice</a>
            </div>
          </div>
          <div class="nav-dropdown {% if page.url and '/lackieren/' in page.url %}is-active{% endif %}">
            <button class="nav-dropdown-toggle">Lackieren</button>
            <div class="nav-dropdown-menu">
              <a href="/lackieren/teillackierung/">Teillackierung</a>
              <a href="/lackieren/komplettlackierung/">Komplettlackierung</a>
              <a href="/lackieren/motorrad-fahrrad/">Motorrad- &amp; Fahrradlackierung</a>
              <a href="/lackieren/moebel-kunststoff/">Möbel- &amp; Kunststofflackierung</a>
              <a href="/lackieren/designlackierung/">Designlackierung</a>
            </div>
          </div>
          <div class="nav-dropdown {% if page.url and '/oldtimer/' in page.url %}is-active{% endif %}">
            <button class="nav-dropdown-toggle">Oldtimer</button>
            <div class="nav-dropdown-menu">
              <a href="/oldtimer/restauration/">Restauration</a>
              <a href="/oldtimer/lackierung/">Lackierung</a>
            </div>
          </div>
          <a href="/kontakt/" {% if page.url == '/kontakt/' %}aria-current="page"{% endif %}>Kontakt &amp; Anfahrt</a>
        </nav>
      </div>
    </div>
  </header>

  <main id="main-content">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <p class="footer-copy">&copy; 2026 &mdash; R+P Lackierung GmbH &middot; Alle Rechte vorbehalten</p>
      <nav class="footer-nav">
        <a href="/kontakt/">Kontakt</a>
        <a href="/impressum/">Impressum</a>
        <a href="/datenschutz/">Datenschutz</a>
      </nav>
    </div>
  </footer>

  <div class="fab-stack">
    <button class="fab-theme" aria-label="Theme wechseln" onclick="toggleTheme()">&#9790;</button>
    <a href="tel:07930990111" class="fab-phone" aria-label="Anrufen">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.36 11.36 0 003.55.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.36 11.36 0 00.57 3.55 1 1 0 01-.25 1.02l-2.2 2.22z"/></svg>
    </a>
  </div>

  <script>
  /* Burger toggle */
  var burger = document.querySelector('.burger');
  burger.addEventListener('click', function() {
    var isOpen = document.body.classList.toggle('menu-open');
    this.setAttribute('aria-expanded', isOpen);
    this.setAttribute('aria-label', isOpen ? 'Menü schließen' : 'Menü öffnen');
  });

  /* Dropdown toggles */
  document.querySelectorAll('.nav-dropdown-toggle').forEach(function(btn) {
    btn.setAttribute('aria-expanded', 'false');
    btn.addEventListener('click', function(e) {
      if (window.innerWidth <= 900) {
        e.preventDefault();
        var parent = this.parentElement;
        var wasOpen = parent.classList.contains('is-open');
        document.querySelectorAll('.nav-dropdown.is-open').forEach(function(d) {
          d.classList.remove('is-open');
          d.querySelector('.nav-dropdown-toggle').setAttribute('aria-expanded', 'false');
        });
        if (!wasOpen) {
          parent.classList.add('is-open');
          this.setAttribute('aria-expanded', 'true');
        }
      }
    });
  });

  /* Close menu on link click */
  document.querySelectorAll('.main-nav > a, .nav-dropdown-menu a').forEach(function(link) {
    link.addEventListener('click', function() {
      document.body.classList.remove('menu-open');
      burger.setAttribute('aria-expanded', 'false');
    });
  });

  /* Theme Toggle: Dark → Light → Auto */
  var THEME_KEY = 'rp-theme';
  var modes = ['dark', 'light', 'auto'];
  var icons = { dark: '\u263E', light: '\u2600', auto: '\u25D0' };
  var themeMode = localStorage.getItem(THEME_KEY) || 'dark';

  function applyTheme() {
    var root = document.documentElement;
    var isDark = themeMode === 'dark' ||
      (themeMode === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
    if (isDark) {
      root.classList.remove('light');
    } else {
      root.classList.add('light');
    }
    var btn = document.querySelector('.fab-theme');
    if (btn) btn.textContent = icons[themeMode];
    document.querySelector('meta[name="theme-color"]').content = isDark ? '#0a0a10' : '#f2f0f4';
  }

  function toggleTheme() {
    themeMode = modes[(modes.indexOf(themeMode) + 1) % 3];
    localStorage.setItem(THEME_KEY, themeMode);
    applyTheme();
  }

  applyTheme();
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', applyTheme);

  /* Scroll Reveal (global) */
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    var revealObserver = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
    document.querySelectorAll('.reveal').forEach(function(el) { revealObserver.observe(el); });
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "AutomotiveBusiness",
    "name": "R+P Lackierung GmbH",
