{# === NEWS aus Collection === #}
<section class="news-section">
  <div class="container">
    <h2 class="section-title reveal">Aktuelles &amp; Tipps</h2>

    <div class="news-grid">
      {%- for post in collections.news | reverse %}
      {%- if loop.index <= 12 %}
      <article class="news-card reveal">
        {% if post.data.image %}
        <img src="{{ post.data.image }}" alt="{{ post.data.title }}" class="news-card-image" width="1024" height="1024" loading="lazy">
        {% else %}
        <div class="news-card-placeholder">&#9881;</div>
        {% endif %}
        <div class="news-card-body">
          <h3 class="news-card-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
          <p class="news-card-excerpt">{{ post.data.excerpt }}</p>
          <a href="{{ post.url }}" class="news-card-link">Weiterlesen &rarr;</a>
        </div>
      </article>
      {%- endif %}
      {%- endfor %}
    </div>
  </div>
</section>

