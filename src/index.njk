<script>
function showTab(id) {
  document.querySelectorAll('.info-panel').forEach(function(p) { p.hidden = true; });
  document.querySelectorAll('.info-tab').forEach(function(t) { t.classList.remove('active'); });
  document.getElementById('panel-' + id).hidden = false;
  document.getElementById('tab-' + id).classList.add('active');
}
</script>
